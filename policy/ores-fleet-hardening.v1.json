{
  "api_version": "ores.dev/fleet-hardening/v1",
  "kind": "OrganizationHardeningPolicyBinding",
  "metadata": {
    "organization": "declarative-migrations-test",
    "environment": "test",
    "sql_namespace": "declarative_migrations"
  },
  "spec": {
    "source": {
      "repository": "ORESoftware/ores-gh-bots",
      "path": "config/hardening-fleet.v1.json"
    },
    "sql": {
      "authority": "organization-local-with-central-mirror",
      "namespace": "declarative_migrations",
      "registry_repository": "declarative-migrations/declarative-postgres-migrate.rs",
      "registry_root": "registry/sql/namespaces",
      "local_roots": ["sql/namespaces", "schema/sql"],
      "canonicalization": "JCS",
      "digest": "SHA-256"
    },
    "infrastructure": {
      "cluster_repository": "ORESoftware/k8s-cluster",
      "library_repository": "ORESoftware/k8s-libs-and-shared-defs",
      "migration_repository": "declarative-migrations/declarative-postgres-migrate.rs",
      "layout": "kustomize-base-plus-overlays"
    },
    "repository_baseline": {
      "scope": "all-active-repositories",
      "policy_path": ".ores/repository-hardening.v1.json",
      "required_checks": ["ores-review/openai", "ores-review/claude", "ores-review/gate", "build", "test", "schema-contract"],
      "test_org_first": true,
      "client_language_minimum": 15,
      "priority_languages": ["rust", "dart", "typescript"]
    }
  }
}
